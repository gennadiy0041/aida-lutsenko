---
/**
 * A cinema gate: one frame in 2.39:1 with a slow camera move.
 *
 * `window` turns the gate into a tall window on portrait phones. If the frame has an upright
 * companion (src/assets/stills/<id>-tall.jpg) the phone shows that picture; otherwise the wide
 * frame keeps its 2.39:1 proportion and the camera travels across it.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getFrame, type CameraMove } from '../data/frames';

interface Props {
  id: string;
  /** Slate label when the frame file does not exist yet, e.g. "01". */
  slate?: string;
  priority?: boolean;
  sizes?: string;
  move?: CameraMove;
  window?: boolean;
  class?: string;
}

const { id, slate, priority = false, window: asWindow = false, class: cls } = Astro.props;
const f = getFrame(id);
const move = Astro.props.move ?? f.move ?? 'push';
const useTall = asWindow && Boolean(f.tall);
const PHONE = '(max-width: 767px) and (orientation: portrait)';
const sizes = Astro.props.sizes ?? (asWindow && !useTall ? `${PHONE} 150svh, 100vw` : '100vw');

async function srcset(src: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpg', quality: number) {
  const ws = widths.filter((w) => w < src.width);
  ws.push(Math.min(src.width, widths[widths.length - 1]));
  const out = await Promise.all(ws.map((width) => getImage({ src, width, format, quality })));
  return out.map((im, i) => `${im.src} ${ws[i]}w`).join(', ');
}

const WIDE = [640, 960, 1280, 1600, 1920, 2560];
const TALL = [480, 640, 800, 1080, 1280, 1650];

const wide = f.src
  ? {
      avif: await srcset(f.src, WIDE, 'avif', 58),
      webp: await srcset(f.src, WIDE, 'webp', 74),
      jpg: await srcset(f.src, WIDE, 'jpg', 78),
      fallback: (await getImage({ src: f.src, width: Math.min(f.src.width, 1280), format: 'jpg', quality: 78 })).src,
    }
  : null;
const tall =
  useTall && f.tall
    ? { avif: await srcset(f.tall, TALL, 'avif', 50), webp: await srcset(f.tall, TALL, 'webp', 70) }
    : null;

const style = [
  f.pos && `--pos:${f.pos}`,
  f.posTall && `--pos-tall:${f.posTall}`,
  f.focusX != null && `--focus-x:${f.focusX}`,
]
  .filter(Boolean)
  .join(';');
---

<div
  class:list={['gate', asWindow && 'gate--window', useTall && 'gate--tall', cls]}
  data-move={move}
  data-frame={id}
  style={style || undefined}
>
  {
    f.src && wide ? (
      <picture class="gate__pic">
        {tall && <source media={PHONE} type="image/avif" srcset={tall.avif} sizes="100vw" />}
        {tall && <source media={PHONE} type="image/webp" srcset={tall.webp} sizes="100vw" />}
        <source type="image/avif" srcset={wide.avif} sizes={sizes} />
        <source type="image/webp" srcset={wide.webp} sizes={sizes} />
        <img
          class="gate__img"
          src={wide.fallback}
          srcset={wide.jpg}
          sizes={sizes}
          width={f.src.width}
          height={f.src.height}
          alt={f.alt.en}
          data-alt-ru={f.alt.ru || undefined}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'sync' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </picture>
    ) : (
      <div class="slate" aria-hidden="true">
        <span class="slate__mark slate__mark--tl" />
        <span class="slate__mark slate__mark--tr" />
        <span class="slate__mark slate__mark--bl" />
        <span class="slate__mark slate__mark--br" />
        <span class="slate__label">
          Frame {slate ?? id} <i>·</i> 2.39 : 1
        </span>
      </div>
    )
  }
</div>
