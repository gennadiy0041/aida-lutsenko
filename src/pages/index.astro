---
/**
 * Temporary front door while the three first screens are being chosen.
 * Becomes the film itself once a variant is picked.
 */
import '@fontsource-variable/noto-serif-display/wght.css';
import notoLatin from '@fontsource-variable/noto-serif-display/files/noto-serif-display-latin-wght-normal.woff2?url';
import Base from '../layouts/Base.astro';
import LangToggle from '../components/LangToggle.astro';
import T from '../components/T.astro';
import { person, titles } from '../data/copy';

const title = { en: 'Aida Lutsenko — a film in four chapters', ru: 'Аида Луценко — фильм в четырёх главах' };
const description = {
  en: 'Quarry. Science. Commercialization. Code. The story of Aida Lutsenko, told as a film.',
  ru: 'Карьер. Наука. Коммерциализация. Код. История Аиды Луценко, рассказанная как фильм.',
};
const variants = [
  { n: 1, name: { en: 'Title card', ru: 'Титр' }, note: { en: 'Black screen, letterboxed frame, optical title', ru: 'Чёрный экран, кадр в леттербоксе, оптический титр' } },
  { n: 2, name: { en: 'Campaign', ru: 'Кампания' }, note: { en: 'Ivory paper, the wordmark cut by the frame', ru: 'Бумага цвета слоновой кости, имя разрезано кромкой кадра' } },
  { n: 3, name: { en: 'Trailer', ru: 'Трейлер' }, note: { en: 'Four shots cut like a trailer, the name across the frame edge', ru: 'Монтаж четырёх кадров, имя по нижней кромке кадра' } },
];
---

<Base title={title} description={description} display="'Noto Serif Display Variable'" preload={[notoLatin]} noindex>
  <main class="door">
    <header class="door__bar">
      <p class="credit credit--sand"><T t={titles.kicker} /></p>
      <LangToggle />
    </header>
    <div class="door__body">
      <h1 class="door__name"><T t={person.name} /></h1>
      <p class="credit door__lead"><T t={{ en: 'Three first screens', ru: 'Три первых экрана' }} /></p>
      <ol class="door__list">
        {
          variants.map((v) => (
            <li>
              <a class="door__link" href={`/v${v.n}`}>
                <span class="credit credit--sand door__n">0{v.n}</span>
                <span class="door__title"><T t={v.name} /></span>
                <span class="door__note"><T t={v.note} /></span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Base>

<style is:global>
  .door {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    --pad: clamp(1.25rem, 3.4vw, 3.75rem);
  }
  .door__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.75rem) var(--pad);
  }
  .door__bar p {
    margin: 0;
  }
  .door__body {
    align-self: center;
    width: min(100%, 62rem);
    margin-inline: auto;
    padding: 2rem var(--pad) 5rem;
  }
  .door__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 5.4vw, 5rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .door__lead {
    margin: clamp(2.5rem, 6svh, 4.5rem) 0 0;
    opacity: 0.7;
  }
  .door__list {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(199 173 133 / 0.28);
  }
  .door__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.4fr);
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding: clamp(1.1rem, 2.4vw, 1.9rem) 0;
    border-bottom: 1px solid rgb(199 173 133 / 0.28);
    transition: color 0.4s var(--ease-film);
  }
  .door__link:hover {
    color: var(--color-sand);
  }
  .door__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2.75rem);
    line-height: 1.1;
  }
  .door__note {
    font-size: 0.95rem;
    color: var(--color-bone);
  }
  @media (max-width: 640px) {
    .door__link {
      grid-template-columns: 2.5rem 1fr;
    }
    .door__note {
      grid-column: 2;
    }
  }
</style>
