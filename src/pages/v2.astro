---
/**
 * Variant 2 — CAMPAIGN.
 * A fashion-house campaign on ivory paper: the wordmark is cut by the top edge of the frame,
 * ink above it, ivory inside it.
 */
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import cormorantLatin from '@fontsource-variable/cormorant-garamond/files/cormorant-garamond-latin-wght-normal.woff2?url';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import LangToggle from '../components/LangToggle.astro';
import T from '../components/T.astro';
import VariantNav from '../components/VariantNav.astro';
import { person, titles, chapters } from '../data/copy';

const title = { en: 'Aida Lutsenko — a film in four chapters', ru: 'Аида Луценко — фильм в четырёх главах' };
const description = {
  en: 'Quarry. Science. Commercialization. Code. The story of Aida Lutsenko, told as a film.',
  ru: 'Карьер. Наука. Коммерциализация. Код. История Аиды Луценко, рассказанная как фильм.',
};
---

<Base
  title={title}
  description={description}
  display="'Cormorant Garamond Variable'"
  preload={[cormorantLatin]}
  theme="light"
  noindex
>
  <main class="v2">
    <section class="v2-hero" aria-labelledby="v2-name">
      <header class="v2-bar">
        <p class="credit v2-in" style="--d:3.3s"><T t={titles.kicker} /></p>
        <LangToggle class="v2-in" />
      </header>

      <div class="v2-stage">
        <h1 id="v2-name" class="v2-mark v2-mark--ink"><T t={person.name} /></h1>
        <div class="v2-frame">
          <Frame id="f01" slate="01" priority window move="pull" />
          <p class="v2-mark v2-mark--light" aria-hidden="true"><T t={person.name} /></p>
        </div>
      </div>

      <footer class="v2-bar v2-bar--bottom">
        <p class="credit v2-in v2-place" style="--d:3.5s">
          <T t={titles.place} /><span class="v2-dash" aria-hidden="true"></span>{titles.years}
        </p>
        <ol class="v2-index credit" aria-label="Chapters">
          {
            chapters.map((c, i) => (
              <li class="v2-in" style={`--d:${(3.6 + i * 0.12).toFixed(2)}s`}>
                <span class="v2-index__n">{c.numeral}</span>
                <T t={c.title} />
              </li>
            ))
          }
        </ol>
        <a class="credit v2-cue v2-in" style="--d:4.1s" href="#chapter-i"><T t={titles.cue} /><span aria-hidden="true">↓</span></a>
      </footer>
    </section>

    <section id="chapter-i" class="v2-chapter" aria-labelledby="v2-ch1">
      <div class="v2-chapter__head">
        <p class="credit v2-chapter__no">N° I</p>
        <h2 id="v2-ch1" class="v2-chapter__title"><T t={{ en: 'Quarry', ru: 'Карьер' }} /></h2>
        <p class="v2-chapter__line">
          <T
            t={{
              en: 'Six years. A crew of forty-five. Almost all of them men.',
              ru: 'Шесть лет. Сорок пять человек. Почти одни мужчины.',
            }}
          />
        </p>
      </div>
      <div class="v2-chapter__frame">
        <Frame id="f02" slate="02" move="pan-right" />
      </div>
    </section>

    <VariantNav current={2} />
  </main>
</Base>

<style is:global>
  .v2 {
    --umber: #6b563d;
    --pad: clamp(1.25rem, 3.4vw, 3.75rem);
    --bar: clamp(4rem, 11svh, 7.5rem);
    /* frame width: as wide as the page allows, never taller than the screen */
    --fw: min(88vw, calc((100svh - 2 * var(--bar) - 6vw) * 2.39));
    --fh: calc(var(--fw) / 2.39);
    --mark: calc(var(--fw) * 0.1165);
    --fx: calc((100vw - var(--fw)) / 2);
    --fy: calc(var(--mark) * 0.5);
  }
  .v2 .credit {
    color: var(--color-ink);
  }

  .v2-hero {
    display: grid;
    grid-template-rows: var(--bar) 1fr var(--bar);
    height: 100svh;
    min-height: 32rem;
  }
  .v2-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-inline: var(--pad);
  }
  .v2-bar p {
    margin: 0;
  }

  .v2-stage {
    position: relative;
    align-self: center;
    height: calc(var(--fy) + var(--fh));
  }
  .v2-mark {
    position: absolute;
    left: 0;
    top: 0;
    width: 100vw;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--mark);
    line-height: 1;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    font-kerning: normal;
  }
  .v2-mark--ink {
    color: var(--color-ink);
  }
  .v2-frame {
    position: absolute;
    left: var(--fx);
    top: var(--fy);
    width: var(--fw);
    height: var(--fh);
    overflow: hidden;
  }
  .v2-frame .gate {
    height: 100%;
  }
  .v2-mark--light {
    left: calc(var(--fx) * -1);
    top: calc(var(--fy) * -1);
    color: var(--color-ivory);
    pointer-events: none;
  }

  .v2-bar--bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }
  .v2-index {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem clamp(1rem, 2.4vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .v2-index__n {
    margin-right: 0.9em;
    color: var(--umber);
  }
  .v2-dash {
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin: 0 0.9em 0.3em;
    background: currentColor;
    opacity: 0.5;
  }
  .v2-cue {
    justify-self: end;
    display: inline-flex;
    gap: 0.9em;
    padding-block: 1rem;
  }

  /* ---------- phones ---------- */
  @media (max-width: 767px) and (orientation: portrait) {
    .v2 {
      --bar: 4.25rem;
      --fw: 100vw;
      --fh: 58svh;
      --mark: 11.3vw;
      --fx: 0px;
    }
    .v2-hero {
      grid-template-rows: var(--bar) auto 1fr;
    }
    .v2-stage {
      align-self: start;
      margin-top: 1.25rem;
    }
    .v2-frame .gate--window {
      --window-h: 100%;
    }
    .v2-bar--top .credit,
    .v2-bar .credit {
      font-size: 0.625rem;
    }
    .v2-bar--bottom {
      grid-template-columns: 1fr auto;
      align-content: center;
      row-gap: 0.9rem;
    }
    .v2-index {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-content: flex-start;
      gap: 0.35rem 1.4rem;
    }
    .v2-place {
      grid-row: 2;
    }
    .v2-cue {
      grid-row: 2;
    }
  }

  /* ---------- the intro ---------- */
  html.motion .v2-mark {
    animation: v2-mark 2.2s 0.3s var(--ease-film) both;
  }
  html.motion .v2-frame {
    animation: v2-open 2.6s 1.25s var(--ease-cut) both;
  }
  html.motion .v2-in {
    animation: v2-in 1.6s var(--d, 3.3s) var(--ease-film) both;
  }
  @keyframes v2-mark {
    from { opacity: 0; transform: translate3d(0, 0.14em, 0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes v2-open {
    from { clip-path: inset(0 50% 0 50%); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes v2-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ---------- how a chapter opens in this language ---------- */
  .v2-chapter {
    padding: clamp(6rem, 18svh, 12rem) 0 clamp(4rem, 10svh, 8rem);
  }
  .v2-chapter__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: end;
    gap: 1.5rem clamp(1.5rem, 4vw, 4rem);
    padding-inline: var(--pad);
  }
  .v2-chapter__head p {
    margin: 0;
  }
  .v2-chapter__no {
    padding-bottom: 1.6em;
    color: var(--umber) !important;
  }
  .v2-chapter__title {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(4.5rem, 13vw, 14rem);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-align: center;
  }
  .v2-chapter__line {
    padding-bottom: 1.2em;
    font-size: clamp(0.95rem, 1.1vw, 1.1rem);
    letter-spacing: 0.02em;
    max-width: 18rem;
  }
  .v2-chapter__frame {
    width: 88vw;
    margin: clamp(3rem, 8svh, 6rem) auto 0;
  }
  @media (max-width: 767px) {
    .v2-chapter__head {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .v2-chapter__title {
      text-align: left;
      font-size: 24vw;
    }
    .v2-chapter__no {
      padding-bottom: 0;
    }
    .v2-chapter__frame {
      width: 100vw;
    }
  }
</style>
