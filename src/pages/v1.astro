---
/**
 * Variant 1 — TITLE CARD.
 * A film premiere: black screen, one letterboxed 2.39:1 frame, the name set as an optical title.
 */
import '@fontsource-variable/noto-serif-display/wght.css';
import notoLatin from '@fontsource-variable/noto-serif-display/files/noto-serif-display-latin-wght-normal.woff2?url';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Letters from '../components/Letters.astro';
import LangToggle from '../components/LangToggle.astro';
import T from '../components/T.astro';
import VariantNav from '../components/VariantNav.astro';
import { person, titles, chapters } from '../data/copy';

const title = { en: 'Aida Lutsenko — a film in four chapters', ru: 'Аида Луценко — фильм в четырёх главах' };
const description = {
  en: 'Quarry. Science. Commercialization. Code. The story of Aida Lutsenko, told as a film.',
  ru: 'Карьер. Наука. Коммерциализация. Код. История Аиды Луценко, рассказанная как фильм.',
};
---

<Base title={title} description={description} display="'Noto Serif Display Variable'" preload={[notoLatin]} noindex>
  <main class="v1">
    <section class="v1-hero" aria-labelledby="v1-name">
      <header class="v1-bar v1-bar--top">
        <p class="credit credit--sand v1-fade" style="--d:2.7s"><T t={titles.kicker} /></p>
        <LangToggle class="v1-fade" />
      </header>

      <div class="v1-stage">
        <Frame id="f01" slate="01" priority window move="push" />
        <div class="v1-veil" aria-hidden="true"></div>
        <div class="v1-curtain" aria-hidden="true"></div>

        <div class="v1-title">
          <h1 id="v1-name" class="v1-name">
            <span data-l="en" lang="en"><Letters text={person.name.en.toUpperCase()} /></span>
            <span data-l="ru" lang="ru"><Letters text={person.name.ru.toUpperCase()} /></span>
          </h1>
          <ol class="v1-billing credit" aria-label="Chapters">
            {
              chapters.map((c, i) => (
                <li class="v1-fade" style={`--d:${(2.9 + i * 0.14).toFixed(2)}s`}>
                  <span class="v1-billing__n">{c.numeral}</span>
                  <T t={c.title} />
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <footer class="v1-bar v1-bar--bottom">
        <p class="credit v1-fade" style="--d:3.3s">
          <T t={titles.place} /><span class="v1-dash" aria-hidden="true"></span>{titles.years}
        </p>
        <a class="credit v1-cue v1-fade" style="--d:3.5s" href="#chapter-i">
          <T t={titles.cue} /><span class="v1-cue__line" aria-hidden="true"></span>
        </a>
      </footer>
    </section>

    <section id="chapter-i" class="v1-chapter" aria-labelledby="v1-ch1">
      <p class="credit credit--sand"><T t={{ en: 'Chapter', ru: 'Глава' }} /></p>
      <p class="v1-chapter__n" aria-hidden="true">I</p>
      <h2 id="v1-ch1" class="v1-chapter__title"><T t={{ en: 'QUARRY', ru: 'КАРЬЕР' }} /></h2>
      <p class="v1-chapter__line">
        <T t={{ en: 'Six years. A crew of forty-five. Almost all of them men.', ru: 'Шесть лет. Сорок пять человек. Почти одни мужчины.' }} />
      </p>
      <div class="v1-chapter__frame">
        <Frame id="f02" slate="02" move="pan-right" />
      </div>
    </section>

    <VariantNav current={1} />
  </main>
</Base>

<style is:global>
  .v1 {
    --bar: clamp(4rem, 13svh, 9.5rem);
    --pad: clamp(1.25rem, 3.4vw, 3.75rem);
    --tracking: 0.2em;
  }

  /* ---------- opening titles ---------- */
  .v1-hero {
    display: grid;
    grid-template-rows: minmax(var(--bar), 1fr) auto minmax(var(--bar), 1fr);
    height: 100svh;
    min-height: 32rem;
    background: var(--color-ink);
  }
  .v1-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-inline: var(--pad);
  }
  .v1-bar p {
    margin: 0;
  }
  .v1-stage {
    position: relative;
    container-type: inline-size;
    width: min(100vw, calc((100svh - 2 * var(--bar)) * 2.39));
    margin-inline: auto;
  }
  .v1-veil,
  .v1-curtain {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .v1-veil {
    background: rgb(11 10 9 / 0.22);
  }
  .v1-curtain {
    background: var(--color-ink);
    opacity: 0;
  }
  .v1-title {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    row-gap: clamp(1.1rem, 2.6cqw, 2.6rem);
    padding-inline: 4cqw;
    text-align: center;
  }
  .v1-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.7rem, 6.15cqw, 8.5rem);
    line-height: 1.08;
    letter-spacing: var(--tracking);
    color: var(--color-ivory);
  }
  .v1-name .letters__word .letters__ch:last-child {
    margin-right: calc(var(--tracking) * -1);
  }
  .v1-billing {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem clamp(1rem, 2.6cqw, 2.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-ivory);
  }
  .v1-billing__n {
    margin-right: 0.9em;
    color: var(--color-sand);
  }
  .v1-dash {
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    margin: 0 0.9em 0.3em;
    background: currentColor;
    opacity: 0.5;
  }
  .v1-cue {
    display: inline-flex;
    align-items: center;
    gap: 1em;
    padding-block: 1rem;
  }
  .v1-cue__line {
    display: block;
    width: 1px;
    height: 2.4rem;
    background: var(--color-sand);
    transform-origin: 50% 0;
  }

  /* ---------- phones: the frame becomes a pan-and-scan window ---------- */
  @media (max-width: 767px) and (orientation: portrait) {
    .v1 {
      --bar: 4.25rem;
      --tracking: 0.17em;
    }
    .v1-hero {
      grid-template-rows: var(--bar) 1fr var(--bar);
      height: 100svh;
    }
    .v1-stage {
      width: 100vw;
      display: grid;
    }
    .v1-stage .gate--window {
      --window-h: 100%;
      height: 100%;
    }
    .v1-name {
      font-size: 12.6cqw;
      line-height: 1.16;
    }
    .v1-name .letters {
      flex-direction: column;
      align-items: center;
    }
    .v1-billing {
      max-width: 19rem;
      gap: 0.35rem 1.4rem;
      font-size: 0.625rem;
    }
    .v1-bar--top .credit {
      max-width: 9.5rem;
      font-size: 0.625rem;
    }
    .v1-bar--bottom .credit {
      font-size: 0.625rem;
    }
    .v1-cue__line {
      height: 1.6rem;
    }
  }

  /* ---------- the intro, only when motion is welcome ---------- */
  html.motion .v1-curtain {
    animation: v1-curtain 3.2s 0.25s var(--ease-film) both;
  }
  html.motion .v1-name .letters__ch {
    animation: v1-settle 2.8s calc(1s + var(--i) * 0.035s) var(--ease-film) both;
  }
  html.motion .v1-fade {
    animation: v1-fade 1.6s var(--d, 2.8s) var(--ease-film) both;
  }
  html.motion .v1-cue__line {
    animation: v1-cue 2.6s 4.2s var(--ease-cut) infinite;
  }
  @keyframes v1-curtain {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes v1-settle {
    from { opacity: 0; transform: translate3d(calc(var(--o) * 0.34em + var(--w, 0) * 0.5em), 0, 0); }
    to { opacity: 1; transform: none; }
  }
  @keyframes v1-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes v1-cue {
    0% { transform: scaleY(0); transform-origin: 50% 0; }
    45% { transform: scaleY(1); transform-origin: 50% 0; }
    55% { transform: scaleY(1); transform-origin: 50% 100%; }
    100% { transform: scaleY(0); transform-origin: 50% 100%; }
  }

  /* ---------- how a chapter opens in this language ---------- */
  .v1-chapter {
    display: grid;
    justify-items: center;
    padding: clamp(6rem, 18svh, 12rem) 0 clamp(4rem, 10svh, 8rem);
    text-align: center;
    background: var(--color-ink);
  }
  .v1-chapter p {
    margin: 0;
  }
  .v1-chapter__n {
    margin-top: 1.5rem !important;
    font-family: var(--font-display);
    font-weight: 200;
    font-size: clamp(4.5rem, 11vw, 11rem);
    line-height: 1;
    color: var(--color-sand);
  }
  .v1-chapter__title {
    margin: clamp(1.25rem, 2.4vw, 2.5rem) 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3.6vw, 3.75rem);
    letter-spacing: 0.34em;
    margin-right: -0.34em;
    line-height: 1.1;
  }
  .v1-chapter__line {
    max-width: 30rem;
    margin-top: clamp(1.5rem, 2.6vw, 2.5rem) !important;
    padding-inline: var(--pad);
    font-size: clamp(0.95rem, 1.15vw, 1.15rem);
    letter-spacing: 0.02em;
    color: var(--color-bone);
  }
  .v1-chapter__frame {
    width: 100%;
    margin-top: clamp(4rem, 10svh, 8rem);
  }
</style>
